# Install gpu_memory_service if wheel exists
RUN --mount=type=cache,target=/home/dynamo/.cache/uv,uid=1000,gid=0,mode=0775 \
    export UV_CACHE_DIR=/home/dynamo/.cache/uv && \
    GMS_WHEEL=$(find /opt/dynamo/wheelhouse -maxdepth 1 -name 'gpu_memory_service*.whl' 2>/dev/null | head -1) && \
    if [ -n "$GMS_WHEEL" ]; then uv pip install "$GMS_WHEEL"; fi

# Install kvbm if wheel exists
RUN --mount=type=cache,target=/home/dynamo/.cache/uv,uid=1000,gid=0,mode=0775 \
