    ln -sf /usr/local/cuda/lib64/libcupti.so* ${SITE_DIR}/nvidia/cuda_cupti/lib/ && \
    ln -sf /usr/local/cuda/extras/CUPTI/lib64/libcupti.so* ${SITE_DIR}/nvidia/cuda_cupti/lib/ 2>/dev/null; \
    ln -sf /usr/local/cuda/lib64/libcusparseLt.so* ${SITE_DIR}/nvidia/cusparselt/lib/ && \
    for f in /usr/lib/x86_64-linux-gnu/libcudnn*.so*; do \
        [ -e "$f" ] && ln -sf "$f" ${SITE_DIR}/nvidia/cudnn/lib/; \
    done && \
    for f in /usr/lib/x86_64-linux-gnu/libnccl*.so*; do \
        [ -e "$f" ] && ln -sf "$f" ${SITE_DIR}/nvidia/nccl/lib/; \
    done && \
    echo 'CUDA libs symlinked into site-packages for TRT-LLM discovery'

# ---- Overlay vLLM packages on top ----
# Copy only vLLM-specific site-packages that do not conflict with TRT-LLM's PyTorch.
# vLLM and TRT-LLM share the same PyTorch from NGC, so we only need vLLM's own packages.
ARG SITE_PACKAGES=${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages
COPY --chmod=775 --chown=dynamo:0 --from=vllm_framework ${SITE_PACKAGES}/vllm ${SITE_PACKAGES}/vllm
COPY --chmod=775 --chown=dynamo:0 --from=vllm_framework ${SITE_PACKAGES}/vllm_omni ${SITE_PACKAGES}/vllm_omni
COPY --chmod=775 --chown=dynamo:0 --from=vllm_framework ${SITE_PACKAGES}/flashinfer_cubin ${SITE_PACKAGES}/flashinfer_cubin
COPY --chmod=775 --chown=dynamo:0 --from=vllm_framework ${SITE_PACKAGES}/flashinfer_jit_cache ${SITE_PACKAGES}/flashinfer_jit_cache

