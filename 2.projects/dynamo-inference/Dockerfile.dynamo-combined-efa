# syntax=docker/dockerfile:1.10
# =============================================================================
# Dockerfile.dynamo-full — NVIDIA Dynamo with vLLM + TRT-LLM from scratch
# =============================================================================
#
# Builds a single image containing BOTH inference backends:
#   - vLLM:    python -m dynamo.vllm     (PyTorch-native)
#   - TRT-LLM: python -m dynamo.trtllm   (TensorRT-optimized)
#
# Architecture: linux/amd64 ONLY
#
# Build:
#   docker buildx build --platform linux/amd64 \
#     -f docker/Dockerfile.dynamo-full \
#     -t dynamo-full:latest .
#
# Key versions (from upstream context.yaml as of 2026-03-17):
#   Dynamo:      1.0.0 (main branch)
#   vLLM:        0.17.1
#   TRT-LLM:     1.3.0rc7
#   CUDA:        12.9 (devel base)
#   Python:      3.12
#   Rust:        1.93.1
#   NCCL:        bundled with cuda-dl-base
#   NIXL:        0.10.1
#   UCX:         v1.20.x
#   GDRCopy:     v2.5.1
#   libfabric:   v2.3.0
#   EFA:         1.45.1
#   NATS:        v2.10.28
#   etcd:        v3.5.21
#   FFmpeg:      7.1
#
# Estimated size: ~40-45 GB
# =============================================================================

# ---------------------
# Build arguments
# ---------------------
ARG DEVICE=cuda
ARG PYTHON_VERSION=3.12
ARG CUDA_VERSION=12.9

# Base images
ARG BASE_IMAGE=nvcr.io/nvidia/cuda-dl-base
ARG BASE_IMAGE_TAG=25.06-cuda12.9-devel-ubuntu24.04

# TRT-LLM pulls PyTorch from NGC
ARG PYTORCH_IMAGE=nvcr.io/nvidia/pytorch
ARG PYTORCH_IMAGE_TAG=25.12-py3

# vLLM runtime image (minimal CUDA runtime for final stage)
ARG RUNTIME_IMAGE=nvcr.io/nvidia/cuda
ARG RUNTIME_IMAGE_TAG=12.9.1-runtime-ubuntu24.04

# Dynamo source
ARG DYNAMO_REF=main

# Component versions
ARG NATS_VERSION=v2.10.28
ARG ETCD_VERSION=v3.5.21
ARG RUST_VERSION=1.93.1
ARG NIXL_REF=0.10.1
ARG NIXL_UCX_REF=v1.20.x
ARG NIXL_GDRCOPY_REF=v2.5.1
ARG NIXL_LIBFABRIC_REF=v2.3.0
ARG EFA_VERSION=1.45.1
ARG FFMPEG_VERSION=7.1

# vLLM
ARG VLLM_REF=v0.17.1
ARG FLASHINF_REF=v0.6.4
ARG LMCACHE_REF=0.4.1
ARG VLLM_OMNI_REF=v0.16.0

# TRT-LLM
ARG TENSORRTLLM_PIP_WHEEL=tensorrt-llm==1.3.0rc7
ARG TENSORRTLLM_INDEX_URL=https://pypi.nvidia.com/
ARG GITHUB_TRTLLM_COMMIT=v1.3.0rc7

# PyTorch component versions (from NGC 25.12)
ARG TORCH_VER=2.10.0a0+b4e4ee81d3.nv25.12
ARG TORCHVISION_VER=0.25.0a0+ca221243
ARG TORCH_TENSORRT_VER=2.10.0a0
ARG TORCHAO_VER=0.15.0+git01374eb5
ARG TORCHDATA_VER=0.11.0
ARG TORCHTITAN_VER=0.2.0
ARG PYTORCH_TRITON_VER=3.5.1+gitbfeb0668.nv25.12
ARG JINJA2_VER=3.1.6
ARG SYMPY_VER=1.14.0
ARG FLASH_ATTN_VER=2.7.4.post1+25.12
ARG FLASHINFER_PYTHON_VER=0.6.1


# =============================================================================
# Stage 1: dynamo_base — Rust, NATS, etcd, uv, sccache
# =============================================================================
FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG} AS dynamo_base

ARG PYTHON_VERSION
ARG NATS_VERSION
ARG ETCD_VERSION
ARG RUST_VERSION

USER root
WORKDIR /opt/dynamo

# sccache (optional, speeds up rebuilds)
ARG SCCACHE_VERSION=v0.14.0
RUN wget --tries=3 --waitretry=5 \
        "https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" && \
    tar -xzf sccache-*.tar.gz && \
    mv sccache-*/sccache /usr/local/bin/ && \
    rm -rf sccache*

# uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# NATS server (Dynamo service mesh)
RUN wget --tries=3 --waitretry=5 \
        "https://github.com/nats-io/nats-server/releases/download/${NATS_VERSION}/nats-server-${NATS_VERSION}-amd64.deb" && \
    dpkg -i nats-server-*.deb && \
    rm nats-server-*.deb

# etcd (Dynamo distributed config)
RUN wget --tries=3 --waitretry=5 \
        "https://github.com/etcd-io/etcd/releases/download/${ETCD_VERSION}/etcd-${ETCD_VERSION}-linux-amd64.tar.gz" \
        -O /tmp/etcd.tar.gz && \
    mkdir -p /usr/local/bin/etcd && \
    tar -xvf /tmp/etcd.tar.gz -C /usr/local/bin/etcd --strip-components=1 && \
    rm /tmp/etcd.tar.gz
ENV PATH=/usr/local/bin/etcd/:$PATH

# Rust toolchain (Dynamo runtime is Rust)
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN wget --tries=3 --waitretry=5 \
        "https://static.rust-lang.org/rustup/archive/1.28.1/x86_64-unknown-linux-gnu/rustup-init" && \
    chmod +x rustup-init && \
    ./rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain ${RUST_VERSION} \
        --default-host x86_64-unknown-linux-gnu && \
    rm rustup-init && \
    chmod -R a+w $RUSTUP_HOME $CARGO_HOME


# =============================================================================
# Stage 2: wheel_builder_base — native libs (UCX, GDRCopy, libfabric, FFmpeg)
# =============================================================================
FROM quay.io/pypa/manylinux_2_28_x86_64 AS wheel_builder_base

ARG PYTHON_VERSION
ARG CARGO_BUILD_JOBS=16
ARG NIXL_UCX_REF
ARG NIXL_GDRCOPY_REF
ARG NIXL_LIBFABRIC_REF
ARG FFMPEG_VERSION

WORKDIR /workspace

# Copy CUDA from base stage
COPY --from=dynamo_base /usr/local/cuda /usr/local/cuda
COPY --from=dynamo_base /etc/ld.so.conf.d/hpcx.conf /etc/ld.so.conf.d/hpcx.conf

# Rust from base
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/opt/dynamo/target \
    PATH=/usr/local/cargo/bin:$PATH
COPY --from=dynamo_base $RUSTUP_HOME $RUSTUP_HOME
COPY --from=dynamo_base $CARGO_HOME $CARGO_HOME

# System build dependencies (AlmaLinux 8 / manylinux)
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    dnf install -y almalinux-release-synergy && \
    dnf config-manager --set-enabled powertools && \
    dnf install -y \
        autoconf automake libtool make \
        rpm-build rpm-sign \
        cmake ninja-build clang-devel \
        gcc-toolset-14-gcc gcc-toolset-14-gcc-c++ gcc-toolset-14-binutils \
        flex wget dkms \
        protobuf-compiler \
        libibverbs libibverbs-devel rdma-core rdma-core-devel \
        libibumad libibumad-devel librdmacm-devel numactl-devel \
        hwloc hwloc-devel libcurl-devel openssl-devel libuuid-devel zlib-devel \
        pkg-config xz

# GCC 14 as default (CUDA requires GCC <= 14)
ENV PATH="/opt/rh/gcc-toolset-14/root/usr/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/rh/gcc-toolset-14/root/usr/lib64:${LD_LIBRARY_PATH:-}" \
    CC="/opt/rh/gcc-toolset-14/root/usr/bin/gcc" \
    CXX="/opt/rh/gcc-toolset-14/root/usr/bin/g++"

# Modern protoc
RUN PROTOC_VERSION=25.3 && \
    wget --tries=3 --waitretry=5 -O /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" && \
    rm -f /usr/local/bin/protoc /usr/bin/protoc && \
    unzip -o /tmp/protoc.zip -d /usr/local bin/protoc include/* && \
    chmod +x /usr/local/bin/protoc && \
    ln -s /usr/local/bin/protoc /usr/bin/protoc && \
    rm /tmp/protoc.zip
ENV PROTOC=/usr/local/bin/protoc

ENV CUDA_PATH=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/lib:/usr/local/lib64:${LD_LIBRARY_PATH:-} \
    NVIDIA_DRIVER_CAPABILITIES=video,compute,utility

# Python venv for building wheels
RUN --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 && \
    uv venv /workspace/.venv --python $PYTHON_VERSION && \
    uv pip install --upgrade meson pybind11 patchelf maturin[patchelf] tomlkit --python /workspace/.venv/bin/python
COPY --from=dynamo_base /bin/uv /bin/uvx /bin/
ENV VIRTUAL_ENV=/workspace/.venv

# --- GDRCopy ---
RUN git clone --depth 1 --branch ${NIXL_GDRCOPY_REF} https://github.com/NVIDIA/gdrcopy.git && \
    cd gdrcopy/packages && \
    CUDA=/usr/local/cuda ./build-rpm-packages.sh && \
    rpm -Uvh gdrcopy-kmod-*.el8.noarch.rpm && \
    rpm -Uvh gdrcopy-*.el8.x86_64.rpm && \
    rpm -Uvh gdrcopy-devel-*.el8.noarch.rpm && \
    cd /workspace && rm -rf gdrcopy

# --- FFmpeg (Apache-licensed codecs only) ---
RUN cd /tmp && \
    curl --retry 5 --retry-delay 3 -LO https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz && \
    tar xf ffmpeg-${FFMPEG_VERSION}.tar.xz && \
    cd ffmpeg-${FFMPEG_VERSION} && \
    ./configure --prefix=/usr/local --disable-gpl --disable-nonfree \
        --disable-programs --disable-doc --disable-static --disable-x86asm \
        --disable-postproc --disable-network --disable-encoders --disable-muxers \
        --disable-bsfs --disable-devices --disable-libdrm --enable-shared && \
    make -j$(nproc) && make install && ldconfig && \
    mkdir -p /usr/local/src/ffmpeg && \
    mv /tmp/ffmpeg-${FFMPEG_VERSION}* /usr/local/src/ffmpeg/

# --- UCX (RDMA/EFA transport for NIXL) ---
RUN cd /usr/local/src && \
    git clone https://github.com/openucx/ucx.git && \
    cd ucx && git checkout $NIXL_UCX_REF && \
    ./autogen.sh && \
    ./contrib/configure-release \
        --prefix=/usr/local/ucx \
        --enable-shared --disable-static --disable-doxygen-doc \
        --enable-optimizations --enable-cma --enable-devel-headers \
        --with-cuda=/usr/local/cuda --with-verbs --with-dm \
        --with-gdrcopy=/usr/local --with-efa --enable-mt && \
    make -j$(nproc) && make -j install-strip && \
    echo "/usr/local/ucx/lib" > /etc/ld.so.conf.d/ucx.conf && \
    echo "/usr/local/ucx/lib/ucx" >> /etc/ld.so.conf.d/ucx.conf && \
    ldconfig

# --- libfabric (EFA provider for NIXL) ---
RUN cd /usr/local/src && \
    git clone https://github.com/ofiwg/libfabric.git && \
    cd libfabric && git checkout $NIXL_LIBFABRIC_REF && \
    ./autogen.sh && \
    ./configure --prefix="/usr/local/libfabric" \
        --disable-verbs --disable-psm3 --disable-opx --disable-usnic --disable-rstream \
        --enable-efa --with-cuda=/usr/local/cuda \
        --enable-cuda-dlopen --with-gdrcopy --enable-gdrcopy-dlopen && \
    make -j$(nproc) && make install && \
    echo "/usr/local/libfabric/lib" > /etc/ld.so.conf.d/libfabric.conf && \
    ldconfig

# --- AWS SDK C++ (S3 support for NIXL OBJ backend) ---
ARG AWS_SDK_CPP_VERSION=1.11.760
RUN git clone --recurse-submodules --depth 1 --branch ${AWS_SDK_CPP_VERSION} \
        https://github.com/aws/aws-sdk-cpp.git /tmp/aws-sdk-cpp && \
    mkdir -p /tmp/aws-sdk-cpp/build && cd /tmp/aws-sdk-cpp/build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_ONLY="s3" \
        -DENABLE_TESTING=OFF -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON && \
    make -j$(nproc) && make install && \
    rm -rf /tmp/aws-sdk-cpp && ldconfig


# =============================================================================
# Stage 3: wheel_builder — Dynamo + NIXL wheels
# =============================================================================
FROM wheel_builder_base AS wheel_builder

ARG NIXL_REF
ARG PYTHON_VERSION
ARG DYNAMO_REF

ENV NIXL_LIB_DIR=/opt/nvidia/nvda_nixl/lib64 \
    NIXL_PLUGIN_DIR=/opt/nvidia/nvda_nixl/lib64/plugins \
    NIXL_PREFIX=/opt/nvidia/nvda_nixl

# Build NIXL (native + Python wheel)
RUN source ${VIRTUAL_ENV}/bin/activate && \
    git clone https://github.com/ai-dynamo/nixl.git && \
    cd nixl && git checkout ${NIXL_REF} && \
    ./contrib/tomlutil.py --wheel-name nixl-cu12 pyproject.toml && \
    mkdir build && \
    meson setup build/ --prefix=/opt/nvidia/nvda_nixl --buildtype=release \
        -Dcudapath_lib="/usr/local/cuda/lib64" \
        -Dcudapath_inc="/usr/local/cuda/include" \
        -Ducx_path="/usr/local/ucx" \
        -Dlibfabric_path="/usr/local/libfabric" && \
    cd build && ninja && ninja install

ENV LD_LIBRARY_PATH=${NIXL_LIB_DIR}:${NIXL_PLUGIN_DIR}:/usr/local/ucx/lib:/usr/local/ucx/lib/ucx:${LD_LIBRARY_PATH:-}

RUN echo "$NIXL_LIB_DIR" > /etc/ld.so.conf.d/nixl.conf && \
    echo "$NIXL_PLUGIN_DIR" >> /etc/ld.so.conf.d/nixl.conf && \
    ldconfig

# NIXL Python wheel
RUN --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv && \
    source ${VIRTUAL_ENV}/bin/activate && \
    cd /workspace/nixl && \
    uv build . --wheel --out-dir /opt/dynamo/dist/nixl --python $PYTHON_VERSION

# Clone Dynamo source and build wheels
RUN git clone --depth 1 --branch ${DYNAMO_REF} \
        https://github.com/ai-dynamo/dynamo.git /opt/dynamo/src

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv && \
    source ${VIRTUAL_ENV}/bin/activate && \
    cd /opt/dynamo/src && \
    mkdir -p ${CARGO_TARGET_DIR} && \
    uv build --wheel --out-dir /opt/dynamo/dist && \
    cd /opt/dynamo/src/lib/bindings/python && \
    maturin build --release --features "kv-indexer" \
        --out /opt/dynamo/dist

# gpu_memory_service wheel
RUN --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv && \
    source ${VIRTUAL_ENV}/bin/activate && \
    uv build --wheel --out-dir /opt/dynamo/dist /opt/dynamo/src/lib/gpu_memory_service


# =============================================================================
# Stage 4: pytorch_base — NGC PyTorch for TRT-LLM
# =============================================================================
FROM ${PYTORCH_IMAGE}:${PYTORCH_IMAGE_TAG} AS pytorch_base


# =============================================================================
# Stage 5: trtllm_framework — TRT-LLM + PyTorch in a venv
# =============================================================================
FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG} AS trtllm_framework

ARG PYTHON_VERSION
ARG TENSORRTLLM_PIP_WHEEL
ARG TENSORRTLLM_INDEX_URL
ARG GITHUB_TRTLLM_COMMIT
ARG TORCH_VER
ARG TORCHVISION_VER
ARG TORCH_TENSORRT_VER
ARG TORCHAO_VER
ARG TORCHDATA_VER
ARG TORCHTITAN_VER
ARG PYTORCH_TRITON_VER
ARG JINJA2_VER
ARG SYMPY_VER
ARG FLASH_ATTN_VER
ARG FLASHINFER_PYTHON_VER

COPY --from=dynamo_base /bin/uv /bin/uvx /bin/

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION}-dev python3-pip curl git git-lfs ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create venv
RUN mkdir -p /opt/dynamo/venv && \
    uv venv /opt/dynamo/venv --python $PYTHON_VERSION
ENV VIRTUAL_ENV=/opt/dynamo/venv \
    PATH="/opt/dynamo/venv/bin:${PATH}"

# Copy PyTorch packages from NGC image into our venv
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torch \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torch
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torch-${TORCH_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torch-${TORCH_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchvision \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchvision
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchvision-${TORCHVISION_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchvision-${TORCHVISION_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchvision.libs \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchvision.libs
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchao \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchao
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchao-${TORCHAO_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchao-${TORCHAO_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchdata \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchdata
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchdata-${TORCHDATA_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchdata-${TORCHDATA_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchtitan \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchtitan
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchtitan-${TORCHTITAN_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchtitan-${TORCHTITAN_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/pytorch_triton-${PYTORCH_TRITON_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/pytorch_triton-${PYTORCH_TRITON_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torchgen \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torchgen
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/functorch \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/functorch
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/jinja2 \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/jinja2
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/jinja2-${JINJA2_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/jinja2-${JINJA2_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/sympy \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/sympy
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/sympy-${SYMPY_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/sympy-${SYMPY_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/flash_attn \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/flash_attn
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/flash_attn-${FLASH_ATTN_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/flash_attn-${FLASH_ATTN_VER}.dist-info
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/flash_attn_2_cuda.cpython-*-*-linux-gnu.so \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torch_tensorrt \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torch_tensorrt
COPY --from=pytorch_base /usr/local/lib/python${PYTHON_VERSION}/dist-packages/torch_tensorrt-${TORCH_TENSORRT_VER}.dist-info \
    ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torch_tensorrt-${TORCH_TENSORRT_VER}.dist-info

# FlashInfer for TRT-LLM
RUN --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 && \
    uv pip install flashinfer-python==${FLASHINFER_PYTHON_VER}

# cuda-python
RUN --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 && \
    uv pip install "cuda-python==13.0.2"

# Clean conflicting CUDA repo configs
RUN [ -f /etc/pip/constraint.txt ] && : > /etc/pip/constraint.txt || true && \
    rm -f /etc/apt/sources.list.d/cuda*.list && \
    rm -f /usr/share/keyrings/cuda-archive-keyring.gpg && \
    rm -f /etc/apt/trusted.gpg.d/cuda*.gpg

# Install TRT-LLM from PyPI/NVIDIA index
RUN --mount=type=cache,target=/root/.cache/uv \
    export UV_CACHE_DIR=/root/.cache/uv UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 && \
    TRTLLM_VERSION=$(echo "${TENSORRTLLM_PIP_WHEEL}" | sed -E 's/tensorrt-llm==([0-9a-zA-Z.+-]+).*/\1/') && \
    PYTHON_TAG="cp$(echo ${PYTHON_VERSION} | tr -d '.')" && \
    DIRECT_URL="https://pypi.nvidia.com/tensorrt-llm/tensorrt_llm-${TRTLLM_VERSION}-${PYTHON_TAG}-${PYTHON_TAG}-linux_x86_64.whl" && \
    uv pip install --index-strategy=unsafe-best-match \
        --extra-index-url "${TENSORRTLLM_INDEX_URL}" \
        "${DIRECT_URL}" triton==3.5.1

# Run TRT-LLM's bundled TensorRT installer
RUN TRT_INSTALLER="$(python -c "import glob, os, site; paths = site.getsitepackages(); \
        installer = ''; \
        [installer:=matches[0] for base in paths \
            for matches in [glob.glob(os.path.join(base, 'tensorrt_llm', '**', 'install_tensorrt.sh'), recursive=True)] \
            if matches and not installer]; \
        print(installer)")" && \
    if [ -z "$TRT_INSTALLER" ]; then echo "No install_tensorrt.sh found"; exit 1; fi && \
    sed -i 's/pip3 install/uv pip install/g' "$TRT_INSTALLER" && \
    bash "$TRT_INSTALLER"


# =============================================================================
# Stage 6: vllm_framework — vLLM built from release wheel
# =============================================================================
FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG} AS vllm_framework

ARG PYTHON_VERSION
ARG VLLM_REF
ARG FLASHINF_REF
ARG LMCACHE_REF
ARG VLLM_OMNI_REF
ARG CUDA_VERSION

COPY --from=dynamo_base /bin/uv /bin/uvx /bin/

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends --fix-missing \
        curl ca-certificates zip unzip git lsb-release numactl wget vim && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION}-dev build-essential cmake \
        ibverbs-providers ibverbs-utils libibumad-dev libibverbs-dev \
        libnuma-dev librdmacm-dev rdma-core && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/dynamo/venv && \
    uv venv /opt/dynamo/venv --python $PYTHON_VERSION
ENV VIRTUAL_ENV=/opt/dynamo/venv \
    PATH="/opt/dynamo/venv/bin:${PATH}" \
    CUDA_HOME=/usr/local/cuda \
    MAX_JOBS=10

# Extract version number from ref (v0.17.1 -> 0.17.1)
RUN VLLM_VER="${VLLM_REF#v}" && \
    TORCH_BACKEND="cu$(echo $CUDA_VERSION | tr -d '.')" && \
    echo "Installing vLLM ${VLLM_VER} for ${TORCH_BACKEND}" && \
    uv pip install pip cuda-python && \
    uv pip install "vllm[flashinfer,runai]==${VLLM_VER}" --torch-backend=${TORCH_BACKEND} && \
    uv pip install flashinfer-cubin==${FLASHINF_REF#v} && \
    uv pip install flashinfer-jit-cache==${FLASHINF_REF#v} \
        --extra-index-url "https://flashinfer.ai/whl/${TORCH_BACKEND}" && \
    echo "vLLM ${VLLM_VER} installed"

# LMCache (build from source for PyTorch 2.10+ compat)
RUN VLLM_VER="${VLLM_REF#v}" && \
    if [ -n "${LMCACHE_REF}" ]; then \
        git clone --depth 1 --branch v${LMCACHE_REF} \
            https://github.com/LMCache/LMCache.git /tmp/lmcache && \
        cd /tmp/lmcache && \
        uv pip install -r requirements/build.txt && \
        TORCH_LIB=$(python3 -c "import torch, os; print(os.path.dirname(torch.__file__) + '/lib')") && \
        TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;10.0+PTX" \
            LDFLAGS="-Wl,-rpath,${TORCH_LIB}" \
            uv pip install --no-build-isolation --no-cache . && \
        rm -rf /tmp/lmcache; \
    fi

# vLLM-Omni
RUN if [ -n "${VLLM_OMNI_REF}" ]; then \
        VLLM_BIN=$(which vllm) && cp "$VLLM_BIN" /tmp/vllm-backup && \
        uv pip install vllm-omni==${VLLM_OMNI_REF#v} 2>/dev/null || \
        ( git clone --depth 1 --branch ${VLLM_OMNI_REF} \
            https://github.com/vllm-project/vllm-omni.git /tmp/vllm-omni && \
          uv pip install /tmp/vllm-omni && rm -rf /tmp/vllm-omni ) && \
        cp /tmp/vllm-backup "$VLLM_BIN"; \
    fi

# Clone vLLM source for DeepGEMM + EP kernels
RUN cd /opt && \
    git clone --depth 1 --branch ${VLLM_REF} \
        https://github.com/vllm-project/vllm.git vllm && \
    cd vllm/tools && \
    bash install_deepgemm.sh --cuda-version "${CUDA_VERSION}" && \
    cd ep_kernels/ && \
    TORCH_CUDA_ARCH_LIST="9.0;10.0" bash install_python_libraries.sh

ENV LD_LIBRARY_PATH=/opt/vllm/tools/ep_kernels/ep_kernels_workspace/nvshmem_install/lib:${LD_LIBRARY_PATH:-}


# =============================================================================
# Stage 7: final — Combined runtime image
