# ---- Expose system CUDA libs to TRT-LLM's sys.path-based library finder ----
# TRT-LLM searches sys.path (Python dirs) for libs like libcublas.so, not LD_LIBRARY_PATH.
# Create a nvidia/cublas/lib/ tree under site-packages to mimic the pip nvidia-cublas-cu12 layout.
RUN SITE_DIR=${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages && \
    mkdir -p ${SITE_DIR}/nvidia/cublas/lib \
             ${SITE_DIR}/nvidia/cuda_runtime/lib \
