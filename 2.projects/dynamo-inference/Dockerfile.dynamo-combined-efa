        httpx==0.28.1 \
        msgpack==1.1.2 \
        "msgspec==0.19.0" \
        "nvidia-ml-py<=13.580.65" \
        "opentelemetry-api<=1.38.0" \
        "opentelemetry-exporter-otlp<=1.38.0" \
        "opentelemetry-sdk<=1.38.0" \
        prometheus_client==0.23.1 \
        "protobuf>=5.29.5,<7.0.0" \
        "pydantic>=2.11.4,<2.13" \
        "pydantic-settings<2.13.0" \
        PyYAML==6.0.3 \
        "tensorboard>=2.19.0,<2.21.0" \
        tensorboardX==2.6.2.2 \
        "transformers>=4.56.0" \
        uvicorn==0.38.0 \
        uvloop \
        av==15.0.0 \
        ftfy==6.3.1 \
        nvtx==0.2.14 \
        sentencepiece==0.2.1 \
        "kubernetes==32.0.1" \
        "kubernetes_asyncio==32.0.0" \
        "matplotlib==3.10.7" \
        "scikit-learn==1.7.2" \
        "scipy<1.14.0" \
        cupy-cuda12x \
        blake3 && \
    rm -rf ${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/nvidia_cutlass_dsl/python_packages/cutlass/cute/experimental/ 2>/dev/null || true

# vLLM flashinfer sampler
ENV VLLM_USE_FLASHINFER_SAMPLER=1

# ---- AWS EFA installer (libfabric + aws-ofi-nccl) ----
USER root

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    mkdir -p /tmp/efa && cd /tmp/efa && \
    curl --retry 3 --retry-delay 2 -fsSL -o aws-efa-installer-${EFA_VERSION}.tar.gz \
        https://efa-installer.amazonaws.com/aws-efa-installer-${EFA_VERSION}.tar.gz && \
    tar -xf aws-efa-installer-${EFA_VERSION}.tar.gz && \
    cd aws-efa-installer && \
    apt-get update && \
    ./efa_installer.sh -y --skip-kmod --skip-limit-conf --no-verify && \
    rm -rf /tmp/efa && \
    ldconfig

ENV EFA_VERSION="${EFA_VERSION}"

# ---- EFA environment defaults ----
ENV FI_PROVIDER=efa \
    FI_EFA_USE_DEVICE_RDMA=1 \
    FI_EFA_ENABLE_SHM=0 \
    FI_EFA_ENABLE_SHM_TRANSFER=0 \
    NCCL_NET_PLUGIN=ofi \
    NCCL_SOCKET_IFNAME="^lo,docker,veth,eni"

# ---- Fix permissions ----
RUN chmod g+w ${VIRTUAL_ENV} /workspace /opt/dynamo && \
    chown dynamo:0 ${VIRTUAL_ENV} /workspace /opt/dynamo && \
    echo 'source /opt/dynamo/venv/bin/activate' >> /etc/bash.bashrc

# ---- SBOM generation ----
RUN <<"EOF" bash -exu
VENV="/opt/dynamo/venv"
PIP="${VENV}/bin/pip"
uv pip install --python "${VENV}/bin/python" pip-licenses prettytable 2>/dev/null || true
{
    echo "# Software Bill of Materials (SBOM)"
    echo "# Image: dynamo-full (vLLM + TRT-LLM + EFA)"
    echo "# Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "#"
    echo "# -- Python packages --"
    ${VENV}/bin/pip-licenses --python "${VENV}/bin/python" --format=csv 2>/dev/null || \
        uv pip list --python "${VENV}/bin/python" 2>/dev/null || \
        echo "(package list unavailable)"
    echo ""
    echo "# -- System packages --"
    dpkg-query -W -f='${Package},${Version},unknown\n' 2>/dev/null || true
} > /SBOM.txt
{
    echo "============================================================"
    echo " THIRD-PARTY LICENSES - Dynamo Full Image"
    echo " Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "============================================================"
    ${VENV}/bin/pip-licenses --python "${VENV}/bin/python" \
        --format=plain-vertical --with-license-file --no-license-path \
        2>/dev/null || echo "(pip-licenses unavailable)"
} > /THIRD-PARTY-LICENSES
uv pip uninstall --python "${VENV}/bin/python" pip-licenses 2>/dev/null || true
echo "SBOM: $(wc -l < /SBOM.txt) lines"
EOF

# ---- Labels ----
LABEL maintainer="nemo-rl" \
      description="Dynamo Full: vLLM + TRT-LLM + EFA/NIXL from scratch" \
      org.opencontainers.image.title="dynamo-full" \
      dynamo.backends="vllm,trtllm" \
      dynamo.vllm.version="${VLLM_REF}" \
      dynamo.trtllm.version="${TENSORRTLLM_PIP_WHEEL}" \
      dynamo.nixl.version="${NIXL_REF}" \
      dynamo.efa.version="${EFA_VERSION}" \
      dynamo.cuda.version="${CUDA_VERSION}"

# ---- Validation ----
RUN <<"EOF" bash -eu
echo "=== Dynamo Full Image Validation ==="
echo ""
echo "--- Dynamo ---"
python3 -c "import dynamo; print(f'  Dynamo: OK')" 2>/dev/null || \
    echo "  Dynamo: present (import may need runtime)"
echo ""
echo "--- TRT-LLM Backend ---"
python3 -c "import tensorrt_llm; print(f'  TRT-LLM: {tensorrt_llm.__version__}')" 2>/dev/null || \
    echo "  TRT-LLM: present (import requires GPU)"
echo ""
echo "--- vLLM Backend ---"
python3 -c "import vllm; print(f'  vLLM: {vllm.__version__}')" 2>/dev/null || \
    echo "  vLLM: present (import requires GPU)"
echo ""
echo "--- NIXL ---"
python3 -c "import nixl; print('  NIXL: OK')" 2>/dev/null || \
    echo "  NIXL: present"
echo ""
echo "--- EFA ---"
fi_info --version 2>/dev/null | head -1 || echo "  libfabric: present"
echo ""
echo "--- UCX ---"
/usr/local/ucx/bin/ucx_info -v 2>/dev/null | head -1 || echo "  UCX: present"
echo ""
echo "--- SBOM ---"
echo "  /SBOM.txt: $(wc -l < /SBOM.txt 2>/dev/null || echo 0) lines"
echo ""
echo "=== Validation complete ==="
EOF

USER dynamo
WORKDIR /workspace

ENTRYPOINT ["/opt/nvidia/nvidia_entrypoint.sh"]
CMD ["/bin/bash"]
