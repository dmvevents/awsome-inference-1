# syntax=docker/dockerfile:1.10
# =============================================================================
# Dynamo Combined EFA — TRT-LLM + vLLM in one image, clean overlay pattern
# =============================================================================
# A single deployable container that serves EITHER the TRT-LLM or vLLM backend
# from NVIDIA's official Dynamo runtime images, with our EFA/NCCL/NIXL stack
# layered on top via a clean multi-stage overlay.
#
# Selection at runtime:
#   docker run ... -e DYNAMO_BACKEND=trtllm dynamo-combined-efa:v1
#   docker run ... -e DYNAMO_BACKEND=vllm   dynamo-combined-efa:v1
#
# Design goals (contrast with the discarded docs/reference/Dockerfile.dynamo-combined-efa):
#   - No libc10_compat.so ABI shim, no LD_PRELOAD hack
#   - No sed-patched Python source
#   - No 90+ line .so copy list — uses directory copies from networking-base:v5
#   - Inherits CVE remediation + pinned versions from networking-base:v5
#   - Inherits official Dynamo runtime images (no from-source rebuild)
#   - Consistent EFA 1.48.0 / libfabric 2.4.0amzn3.0 / aws-ofi-nccl 1.19.0-1 NGC v1
#
# Build:
#   docker build --build-arg NETWORKING_BASE=networking-base:v5 \
#       -t dynamo-combined-efa:v1 inference/dynamo-combined-efa/
#
# Test distribution (per ticket P416074947):
#   - g5.8xlarge     ( 1 EFA, A10G)  — basic EFA + single-backend smoke
#   - p5.48xlarge    (32 EFA, H100)  — multi-rail EFA + both backends
#   - p5en.48xlarge  (16 EFA, H200)  — multi-rail EFA + both backends
# =============================================================================

ARG NETWORKING_BASE=networking-base:v5
ARG TRTLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/tensorrtllm-runtime:1.0.1
ARG VLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.0.1

# ---------------------
# Networking source (shared)
# ---------------------
FROM ${NETWORKING_BASE} AS networking

# ---------------------
# TRT-LLM stage (intermediate — we harvest it into the combined stage)
# ---------------------
FROM ${TRTLLM_IMAGE} AS trtllm-stage

USER root

# EFA + RDMA core + UCX + NIXL + GDRCopy
COPY --from=networking /opt/gdrcopy            /opt/gdrcopy
COPY --from=networking /usr/local/ucx          /usr/local/ucx
COPY --from=networking /opt/amazon/efa         /opt/amazon/efa
COPY --from=networking /opt/nvidia/nvda_nixl   /opt/nvidia/nvda_nixl

# rdma-core libs w/ EFA_1.4 symbols (overlay on top of whatever is in the runtime image)
COPY --from=networking /lib/x86_64-linux-gnu/libefa.so*      /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/libibverbs.so*  /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/librdmacm.so*   /lib/x86_64-linux-gnu/

RUN cd /lib/x86_64-linux-gnu \
 && LIBEFA=$(ls libefa.so.1.*.0 2>/dev/null | sort -V | tail -1) \
 && [ -n "$LIBEFA" ] && ln -sf "$LIBEFA" libefa.so.1 && ln -sf "$LIBEFA" libefa.so || true \
 && ldconfig

# Python tooling
COPY --from=networking /usr/local/bin/kubectl /usr/local/bin/kubectl
RUN pip install --no-cache-dir \
      "nemo-evaluator>=0.2.5" \
      "nvidia-resiliency-ext>=0.5.0" \
      "genai-perf>=0.0.16" \
      "nixl>=1.0.0" \
      boto3 2>/dev/null || true

# The Dynamo runtime images install everything into /opt/dynamo/venv.
# Record the prefix and site-packages explicitly so later stages don't guess.
RUN python3 -c "import sys; print(sys.prefix)"             > /opt/.trtllm_prefix \
 && python3 -c "import site; print(site.getsitepackages()[0])" > /opt/.trtllm_sitepkg \
 && test -d /opt/dynamo/venv/lib/python3.12/site-packages/tensorrt_llm \
 && test -x /opt/dynamo/venv/bin/trtllm-serve \
 && test -x /opt/dynamo/venv/bin/trtllm-build

# ---------------------
# vLLM stage (intermediate)
# ---------------------
FROM ${VLLM_IMAGE} AS vllm-stage

USER root

COPY --from=networking /opt/gdrcopy            /opt/gdrcopy
COPY --from=networking /usr/local/ucx          /usr/local/ucx
COPY --from=networking /opt/amazon/efa         /opt/amazon/efa
COPY --from=networking /opt/nvidia/nvda_nixl   /opt/nvidia/nvda_nixl

COPY --from=networking /lib/x86_64-linux-gnu/libefa.so*      /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/libibverbs.so*  /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/librdmacm.so*   /lib/x86_64-linux-gnu/

RUN cd /lib/x86_64-linux-gnu \
 && LIBEFA=$(ls libefa.so.1.*.0 2>/dev/null | sort -V | tail -1) \
 && [ -n "$LIBEFA" ] && ln -sf "$LIBEFA" libefa.so.1 && ln -sf "$LIBEFA" libefa.so || true \
 && ldconfig

COPY --from=networking /usr/local/bin/kubectl /usr/local/bin/kubectl
RUN pip install --no-cache-dir \
      "nemo-evaluator>=0.2.5" \
      "nvidia-resiliency-ext>=0.5.0" \
      "genai-perf>=0.0.16" \
      "nixl>=1.0.0" \
      boto3 2>/dev/null || true

# ---------------------
# Combined final stage — built on vLLM runtime as the base, with TRT-LLM stack
# overlaid into an isolated prefix so the two Python environments don't clash.
# ---------------------
FROM vllm-stage AS combined

USER root

# Isolate TRT-LLM into /opt/trtllm so we don't stomp vLLM's site-packages.
# The Dynamo TRT-LLM runtime ships everything under /opt/dynamo/venv. We keep
# its self-contained venv intact at /opt/trtllm-venv and expose a /opt/trtllm
# directory with just the symlinks that the entrypoint needs.
COPY --from=trtllm-stage /opt/dynamo/venv                    /opt/trtllm-venv
COPY --from=trtllm-stage /opt/.trtllm_prefix                 /opt/trtllm/.prefix
COPY --from=trtllm-stage /opt/.trtllm_sitepkg                /opt/trtllm/.sitepkg

# Quick sanity — the TRT-LLM venv must be usable as-is (it is a self-contained
# Python environment, so Python itself doesn't run yet, but the files exist).
RUN test -d /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm \
 && test -x /opt/trtllm-venv/bin/trtllm-serve \
 && test -x /opt/trtllm-venv/bin/trtllm-build \
 && mkdir -p /opt/trtllm/bin \
 && ln -sf /opt/trtllm-venv/bin/trtllm-serve /opt/trtllm/bin/trtllm-serve \
 && ln -sf /opt/trtllm-venv/bin/trtllm-build /opt/trtllm/bin/trtllm-build \
 && ln -sf /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm /opt/trtllm/tensorrt_llm

# The official Dynamo runtime images use /workspace as the CWD; keep that.
WORKDIR /workspace

# Backend selector entrypoint — picks PYTHONPATH/PATH based on DYNAMO_BACKEND
COPY entrypoint.sh /usr/local/bin/dynamo-combined-entrypoint
RUN chmod +x /usr/local/bin/dynamo-combined-entrypoint

ENV LD_LIBRARY_PATH="/opt/nvidia/nvda_nixl/lib64:/opt/nvidia/nvda_nixl/lib64/plugins:/usr/local/ucx/lib:/opt/amazon/efa/lib:/opt/gdrcopy/lib:${LD_LIBRARY_PATH:-}" \
    PATH="/usr/local/ucx/bin:/opt/amazon/efa/bin:${PATH}" \
    FI_PROVIDER=efa \
    FI_EFA_USE_DEVICE_RDMA=1 \
    FI_EFA_ENABLE_SHM=0 \
    FI_EFA_ENABLE_SHM_TRANSFER=0 \
    NCCL_NET_PLUGIN=ofi \
    NCCL_TUNER_PLUGIN=ofi \
    NCCL_GIN_TYPE=2 \
    NCCL_NVLS_ENABLE=0 \
    NCCL_SOCKET_IFNAME="^lo,docker,veth,eni" \
    HPCX_DIR="" HPCX_MPI_DIR="" HPCX_HOME="" HPCX_UCX_DIR="" \
    DYNAMO_BACKEND=vllm

# Validation — runtime-deferred (import-heavy checks happen at startup, not build)
RUN echo "=== dynamo-combined-efa build validation ===" \
 && ls /opt/nvidia/nvda_nixl/lib64/plugins/libplugin_LIBFABRIC.so \
 && echo "NIXL LIBFABRIC plugin: present" \
 && ls /opt/amazon/efa/lib/libfabric.so* >/dev/null \
 && echo "libfabric: present" \
 && ls /opt/trtllm/tensorrt_llm >/dev/null \
 && echo "TRT-LLM staged at /opt/trtllm" \
 && python3 -c "import vllm; print(f'vLLM {vllm.__version__}: OK')" 2>/dev/null \
     || echo "vLLM import deferred to runtime" \
 && echo "=== OK ==="

ENTRYPOINT ["/usr/local/bin/dynamo-combined-entrypoint"]
CMD ["--help"]
