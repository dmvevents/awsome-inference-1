# syntax=docker/dockerfile:1.10
# =============================================================================
# Dockerfile.dynamo-combined-efa — Dynamo with vLLM + TRT-LLM over EFA
# =============================================================================
#
# Single deployable container serving EITHER the TRT-LLM or vLLM backend from
# NVIDIA's official Dynamo runtime images, with the EFA/NCCL/NIXL networking
# stack overlaid. Includes SBOM (syft) and CVE scanning (trivy) in-build.
#
# Runtime backend selection:
#   docker run ... -e DYNAMO_BACKEND=vllm   dynamo-combined-efa:v1  (default)
#   docker run ... -e DYNAMO_BACKEND=trtllm dynamo-combined-efa:v1
#
# Multi-arch build:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#       -f Dockerfile.dynamo-combined-efa \
#       -t dynamo-combined-efa:v1 .
#
# Single-arch (typical for GPU clusters):
#   docker buildx build --platform linux/amd64 \
#       -f Dockerfile.dynamo-combined-efa \
#       -t dynamo-combined-efa:v1 .
#
# Build args:
#   NETWORKING_BASE  — networking-base image (default: public ECR)
#   TRTLLM_IMAGE     — TRT-LLM runtime source (default: NGC 1.0.1)
#   VLLM_IMAGE       — vLLM runtime source (default: NGC 1.0.1)
#   GENERATE_SBOM    — "0" to skip SBOM (default: "1")
#   CVE_SCAN         — "0" to skip CVE scan (default: "1")
#
# Security artifacts (inside image at /opt/security/):
#   sbom.spdx.json       — SPDX 2.3 SBOM
#   sbom.cyclonedx.json  — CycloneDX 1.5 SBOM
#   cve-report.txt       — Trivy CRITICAL + HIGH
#   cve-critical.txt     — Trivy CRITICAL only
#
# =============================================================================

ARG NETWORKING_BASE=public.ecr.aws/v9l4g5s4/networking-base:v5
ARG TRTLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/tensorrtllm-runtime:1.0.1
ARG VLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.0.1

# ---------------------
# Networking source (shared)
# ---------------------
FROM ${NETWORKING_BASE} AS networking

# ---------------------
# Security scanner binaries (multi-arch)
# ---------------------
FROM aquasec/trivy:latest AS trivy-bin
FROM anchore/syft:latest AS syft-bin

# ---------------------
# TRT-LLM stage
# ---------------------
FROM ${TRTLLM_IMAGE} AS trtllm-stage

USER root

# EFA + RDMA core + UCX + NIXL + GDRCopy
COPY --from=networking /opt/gdrcopy            /opt/gdrcopy
COPY --from=networking /usr/local/ucx          /usr/local/ucx
COPY --from=networking /opt/amazon/efa         /opt/amazon/efa
COPY --from=networking /opt/nvidia/nvda_nixl   /opt/nvidia/nvda_nixl

# rdma-core libs w/ EFA_1.4 symbols
COPY --from=networking /lib/x86_64-linux-gnu/libefa.so*      /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/libibverbs.so*  /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/librdmacm.so*   /lib/x86_64-linux-gnu/

RUN cd /lib/x86_64-linux-gnu \
 && LIBEFA=$(ls libefa.so.1.*.0 2>/dev/null | sort -V | tail -1) \
 && [ -n "$LIBEFA" ] && ln -sf "$LIBEFA" libefa.so.1 && ln -sf "$LIBEFA" libefa.so || true \
 && ldconfig

# Python tooling
COPY --from=networking /usr/local/bin/kubectl /usr/local/bin/kubectl
RUN pip install --no-cache-dir \
      "nemo-evaluator>=0.2.5" \
      "nvidia-resiliency-ext>=0.5.0" \
      "genai-perf>=0.0.16" \
      "nixl>=1.0.0" \
      boto3 2>/dev/null || true

RUN echo "/opt/dynamo/venv"                                 > /opt/.trtllm_prefix \
 && echo "/opt/dynamo/venv/lib/python3.12/site-packages"    > /opt/.trtllm_sitepkg \
 && test -d /opt/dynamo/venv/lib/python3.12/site-packages/tensorrt_llm \
 && test -x /opt/dynamo/venv/bin/trtllm-serve \
 && test -x /opt/dynamo/venv/bin/trtllm-build

# ---------------------
# vLLM stage
# ---------------------
FROM ${VLLM_IMAGE} AS vllm-stage

USER root

COPY --from=networking /opt/gdrcopy            /opt/gdrcopy
COPY --from=networking /usr/local/ucx          /usr/local/ucx
COPY --from=networking /opt/amazon/efa         /opt/amazon/efa
COPY --from=networking /opt/nvidia/nvda_nixl   /opt/nvidia/nvda_nixl

COPY --from=networking /lib/x86_64-linux-gnu/libefa.so*      /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/libibverbs.so*  /lib/x86_64-linux-gnu/
COPY --from=networking /lib/x86_64-linux-gnu/librdmacm.so*   /lib/x86_64-linux-gnu/

RUN cd /lib/x86_64-linux-gnu \
 && LIBEFA=$(ls libefa.so.1.*.0 2>/dev/null | sort -V | tail -1) \
 && [ -n "$LIBEFA" ] && ln -sf "$LIBEFA" libefa.so.1 && ln -sf "$LIBEFA" libefa.so || true \
 && ldconfig

COPY --from=networking /usr/local/bin/kubectl /usr/local/bin/kubectl
RUN pip install --no-cache-dir \
      "nemo-evaluator>=0.2.5" \
      "nvidia-resiliency-ext>=0.5.0" \
      "genai-perf>=0.0.16" \
      "nixl>=1.0.0" \
      boto3 2>/dev/null || true

# ---------------------
# Combined stage — vLLM base + TRT-LLM overlay
# ---------------------
FROM vllm-stage AS combined

USER root

# OpenMPI runtime: TRT-LLM's torch binary links libmpi.so.40 at load time.
# Distro openmpi is safe here — HPCX is kept unset so aws-ofi-nccl is the active
# NCCL network plugin over EFA/libfabric; OpenMPI just satisfies torch's dlopen.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libopenmpi3 openmpi-bin && \
    rm -rf /var/lib/apt/lists/*

COPY --from=trtllm-stage /opt/dynamo/venv                    /opt/trtllm-venv
COPY --from=trtllm-stage /opt/.trtllm_prefix                 /opt/trtllm/.prefix
COPY --from=trtllm-stage /opt/.trtllm_sitepkg                /opt/trtllm/.sitepkg

# Intel MKL libraries required by TRT-LLM's torch.
# The upstream NGC tensorrtllm-runtime ships MKL at /usr/local/lib/libmkl_*.
# Copy them into /opt/trtllm-libs so we can add them to the trtllm-backend
# LD_LIBRARY_PATH without polluting the default (vLLM) runtime linker path.
COPY --from=trtllm-stage /usr/local/lib/libmkl_*            /opt/trtllm-libs/
COPY --from=trtllm-stage /usr/local/lib/libiomp5*           /opt/trtllm-libs/

# CUDA 13 runtime libraries required by TRT-LLM.
# The trtllm venv bundles nvidia-cu13 wheels for some libs but torch expects
# system CUDA 13 runtime libs for libcublas/libcusolver/libcufft/libcudnn.
# vLLM uses CUDA 12.9 (the image's default); TRT-LLM torch uses CUDA 13.
# Segregating under /opt/trtllm-cuda13 keeps the two CUDA stacks side-by-side.
COPY --from=trtllm-stage /usr/local/cuda-13.1/targets/x86_64-linux/lib/  /opt/trtllm-cuda13/
COPY --from=trtllm-stage /usr/local/cuda/include                         /opt/trtllm-cuda13/include

# cuDNN 9 for CUDA 13 (TRT-LLM torch dlopens libcudnn.so.9 during init).
COPY --from=trtllm-stage /usr/lib/x86_64-linux-gnu/libcudnn*   /opt/trtllm-cuda13/
# nccl for CUDA 13 (TRT-LLM's torch links its own NCCL)
COPY --from=trtllm-stage /usr/lib/x86_64-linux-gnu/libnccl.so* /opt/trtllm-cuda13/

RUN test -d /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm \
 && test -x /opt/trtllm-venv/bin/trtllm-serve \
 && test -x /opt/trtllm-venv/bin/trtllm-build \
 && mkdir -p /opt/trtllm/bin \
 && ln -sf /opt/trtllm-venv/bin/trtllm-serve /opt/trtllm/bin/trtllm-serve \
 && ln -sf /opt/trtllm-venv/bin/trtllm-build /opt/trtllm/bin/trtllm-build \
 && ln -sf /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm /opt/trtllm/tensorrt_llm

WORKDIR /workspace

COPY entrypoint.sh /usr/local/bin/dynamo-combined-entrypoint
RUN chmod +x /usr/local/bin/dynamo-combined-entrypoint

ENV LD_LIBRARY_PATH="/opt/nvidia/nvda_nixl/lib64:/opt/nvidia/nvda_nixl/lib64/plugins:/usr/local/ucx/lib:/opt/amazon/efa/lib:/opt/gdrcopy/lib:${LD_LIBRARY_PATH:-}" \
    PATH="/usr/local/ucx/bin:/opt/amazon/efa/bin:${PATH}" \
    FI_PROVIDER=efa \
    FI_EFA_USE_DEVICE_RDMA=1 \
    FI_EFA_ENABLE_SHM=0 \
    FI_EFA_ENABLE_SHM_TRANSFER=0 \
    NCCL_NET_PLUGIN=ofi \
    NCCL_TUNER_PLUGIN=ofi \
    NCCL_GIN_TYPE=2 \
    NCCL_NVLS_ENABLE=0 \
    NCCL_SOCKET_IFNAME="^lo,docker,veth,eni" \
    HPCX_DIR="" HPCX_MPI_DIR="" HPCX_HOME="" HPCX_UCX_DIR="" \
    DYNAMO_BACKEND=vllm

# Filesystem validation (no Python execution — avoids GPU-less CodeBuild stalls)
RUN echo "=== dynamo-combined-efa build validation ===" \
 && ls /opt/nvidia/nvda_nixl/lib64/plugins/libplugin_LIBFABRIC.so \
 && echo "  NIXL LIBFABRIC plugin: present" \
 && ls /opt/amazon/efa/lib/libfabric.so* >/dev/null \
 && echo "  libfabric: present" \
 && ls /opt/trtllm-venv/bin/trtllm-serve >/dev/null \
 && ls /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm >/dev/null \
 && echo "  TRT-LLM venv present at /opt/trtllm-venv" \
 && (ls /opt/dynamo/venv/lib/python3.12/site-packages/vllm >/dev/null 2>&1 \
      && echo "  vLLM site-packages present at /opt/dynamo/venv" \
      || echo "  vLLM: deferred (runtime check)") \
 && echo "=== OK ==="

# ---------------------
# Security scan stage
# ---------------------
FROM combined AS security-scan

ARG GENERATE_SBOM=1
ARG CVE_SCAN=1

COPY --from=trivy-bin /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=syft-bin /syft /usr/local/bin/syft

RUN mkdir -p /opt/security

# SBOM generation (syft — SPDX + CycloneDX)
RUN if [ "$GENERATE_SBOM" = "1" ]; then \
        echo "=== Generating SBOM (SPDX) ===" && \
        syft dir:/ -o spdx-json=/opt/security/sbom.spdx.json 2>/dev/null || \
            echo '{"comment":"sbom generation skipped or failed"}' > /opt/security/sbom.spdx.json && \
        echo "=== Generating SBOM (CycloneDX) ===" && \
        syft dir:/ -o cyclonedx-json=/opt/security/sbom.cyclonedx.json 2>/dev/null || \
            echo '{"comment":"sbom generation skipped or failed"}' > /opt/security/sbom.cyclonedx.json && \
        echo "SBOM generation complete"; \
    else \
        echo '{"comment":"sbom generation disabled"}' > /opt/security/sbom.spdx.json && \
        echo '{"comment":"sbom generation disabled"}' > /opt/security/sbom.cyclonedx.json; \
    fi

# CVE scan (trivy filesystem mode)
RUN if [ "$CVE_SCAN" = "1" ]; then \
        echo "=== CVE Scan (CRITICAL + HIGH) ===" && \
        trivy filesystem --scanners vuln --severity CRITICAL,HIGH \
            --skip-db-update --skip-java-db-update \
            --timeout 10m --quiet / > /opt/security/cve-report.txt 2>&1 || true && \
        echo "=== CVE Scan (CRITICAL only) ===" && \
        trivy filesystem --scanners vuln --severity CRITICAL \
            --skip-db-update --skip-java-db-update \
            --timeout 10m --quiet / > /opt/security/cve-critical.txt 2>&1 || true && \
        echo "CVE scan complete"; \
    else \
        echo "CVE scan disabled" > /opt/security/cve-report.txt && \
        echo "CVE scan disabled" > /opt/security/cve-critical.txt; \
    fi

# ---------------------
# Final stage — clean image with security artifacts, no scanner binaries
# ---------------------
FROM combined AS final

COPY --from=security-scan /opt/security /opt/security

LABEL maintainer="nemo-rl" \
      description="Dynamo Combined EFA — TRT-LLM + vLLM with SBOM and CVE scan" \
      dynamo.trtllm.version="1.0.1" \
      dynamo.vllm.version="1.0.1" \
      efa.version="1.48.0" \
      networking.base="v5" \
      security.sbom="spdx+cyclonedx at /opt/security/" \
      security.cve-scan="trivy at /opt/security/"

ENTRYPOINT ["/usr/local/bin/dynamo-combined-entrypoint"]
CMD ["--help"]
