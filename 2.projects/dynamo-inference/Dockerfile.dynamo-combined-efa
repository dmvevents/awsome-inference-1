             ${SITE_DIR}/nvidia/cusparse/lib \
             ${SITE_DIR}/nvidia/cufft/lib \
             ${SITE_DIR}/nvidia/nvjitlink/lib \
             ${SITE_DIR}/nvidia/cuda_cupti/lib \
             ${SITE_DIR}/nvidia/cusparselt/lib && \
    ln -sf /usr/local/cuda/lib64/libcublas.so* ${SITE_DIR}/nvidia/cublas/lib/ && \
    ln -sf /usr/local/cuda/lib64/libcublasLt.so* ${SITE_DIR}/nvidia/cublas/lib/ && \
    ln -sf /usr/local/cuda/lib64/libcudart.so* ${SITE_DIR}/nvidia/cuda_runtime/lib/ && \
    ln -sf /usr/local/cuda/lib64/libcurand.so* ${SITE_DIR}/nvidia/curand/lib/ && \
