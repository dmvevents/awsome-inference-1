# syntax=docker/dockerfile:1.10
# =============================================================================
# Dynamo Combined EFA — TRT-LLM + vLLM in one image
# =============================================================================
# A single deployable container that serves either the TRT-LLM or the vLLM
# backend from NVIDIA's official Dynamo runtime images, with this repo's
# in-tree AWS EFA base (Dockerfile.efa → aws-efa-dynamo) overlaid onto both.
#
# Runtime backend selection:
#   docker run ... -e DYNAMO_BACKEND=vllm   dynamo-combined-efa:latest
#   docker run ... -e DYNAMO_BACKEND=trtllm dynamo-combined-efa:latest
#
# Build (self-contained — only this folder's Dockerfiles are required):
#   # build.sh orchestrates the 2-step build. It first runs Dockerfile.efa to
#   # produce aws-efa-dynamo:<tag>, then this Dockerfile pulls it as BASE_IMAGE.
#   ./build.sh -b combined -t latest -r <registry>
#
#   # or manually:
#   docker build -f Dockerfile.efa -t aws-efa-dynamo:latest .
#   docker build -f Dockerfile.dynamo-combined-efa \
#       --build-arg BASE_IMAGE=aws-efa-dynamo:latest \
#       -t dynamo-combined-efa:latest .
#
# Test targets (per ticket P416074947):
#   - g5.8xlarge     ( 1 EFA, A10G)  — single-EFA smoke, single-backend serve
#   - p5.48xlarge    (32 EFA, H100)  — multi-rail EFA + both backends
#   - p5en.48xlarge  (16 EFA, H200)  — multi-rail EFA + both backends
# =============================================================================

# ----- Build arguments -----
# BASE_IMAGE is the EFA/NCCL/NIXL foundation built from sibling Dockerfile.efa
# in this same folder. It is the same base used by Dockerfile.dynamo-trtllm-efa
# and Dockerfile.dynamo-vllm-efa.
ARG BASE_IMAGE=aws-efa-dynamo:latest
ARG TRTLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/tensorrtllm-runtime:1.0.1
ARG VLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.0.1


# =============================================================================
# Stage 1: base — EFA/NCCL/NIXL foundation (source: Dockerfile.efa)
# =============================================================================
FROM ${BASE_IMAGE} AS base


# =============================================================================
# Stage 2: trtllm-stage — overlay our base onto NVIDIA's TRT-LLM runtime
# =============================================================================
FROM ${TRTLLM_IMAGE} AS trtllm-stage

USER root

# Copy our EFA stack into the TRT-LLM runtime. Keep directory copies rather
# than individual .so files so libfabric plugin dirs and UCX transports land
# intact. Paths mirror Dockerfile.efa's install prefixes.
COPY --from=base /opt/gdrcopy            /opt/gdrcopy
COPY --from=base /usr/local/ucx          /usr/local/ucx
COPY --from=base /opt/amazon/efa         /opt/amazon/efa
COPY --from=base /opt/amazon/openmpi     /opt/amazon/openmpi
COPY --from=base /opt/nvidia/nvda_nixl   /opt/nvidia/nvda_nixl

# rdma-core libs (with EFA_1.4 symbols) from the base, overlaid onto the
# runtime image's older rdma-core.
COPY --from=base /lib/x86_64-linux-gnu/libefa.so*      /lib/x86_64-linux-gnu/
COPY --from=base /lib/x86_64-linux-gnu/libibverbs.so*  /lib/x86_64-linux-gnu/
COPY --from=base /lib/x86_64-linux-gnu/librdmacm.so*   /lib/x86_64-linux-gnu/

RUN cd /lib/x86_64-linux-gnu \
 && LIBEFA=$(ls libefa.so.1.*.0 2>/dev/null | sort -V | tail -1) \
 && [ -n "$LIBEFA" ] && ln -sf "$LIBEFA" libefa.so.1 && ln -sf "$LIBEFA" libefa.so || true \
 && ldconfig

# Record where the TRT-LLM venv lives for the combined stage.
RUN test -d /opt/dynamo/venv/lib/python3.12/site-packages/tensorrt_llm \
 && test -x /opt/dynamo/venv/bin/trtllm-serve \
 && test -x /opt/dynamo/venv/bin/trtllm-build


# =============================================================================
# Stage 3: vllm-stage — overlay our base onto NVIDIA's vLLM runtime
# =============================================================================
FROM ${VLLM_IMAGE} AS vllm-stage

USER root

COPY --from=base /opt/gdrcopy            /opt/gdrcopy
COPY --from=base /usr/local/ucx          /usr/local/ucx
COPY --from=base /opt/amazon/efa         /opt/amazon/efa
COPY --from=base /opt/amazon/openmpi     /opt/amazon/openmpi
COPY --from=base /opt/nvidia/nvda_nixl   /opt/nvidia/nvda_nixl

COPY --from=base /lib/x86_64-linux-gnu/libefa.so*      /lib/x86_64-linux-gnu/
COPY --from=base /lib/x86_64-linux-gnu/libibverbs.so*  /lib/x86_64-linux-gnu/
COPY --from=base /lib/x86_64-linux-gnu/librdmacm.so*   /lib/x86_64-linux-gnu/

RUN cd /lib/x86_64-linux-gnu \
 && LIBEFA=$(ls libefa.so.1.*.0 2>/dev/null | sort -V | tail -1) \
 && [ -n "$LIBEFA" ] && ln -sf "$LIBEFA" libefa.so.1 && ln -sf "$LIBEFA" libefa.so || true \
 && ldconfig


# =============================================================================
# Stage 4: combined — final image built on vLLM runtime, TRT-LLM venv overlaid
# =============================================================================
FROM vllm-stage AS combined

USER root

# Harvest the TRT-LLM self-contained venv into /opt/trtllm-venv so that the
# entrypoint can activate it when DYNAMO_BACKEND=trtllm without disturbing
# vLLM's site-packages at /opt/dynamo/venv.
COPY --from=trtllm-stage /opt/dynamo/venv /opt/trtllm-venv

# Convenience symlinks for TRT-LLM binaries.
RUN test -d /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm \
 && test -x /opt/trtllm-venv/bin/trtllm-serve \
 && test -x /opt/trtllm-venv/bin/trtllm-build \
 && mkdir -p /opt/trtllm/bin \
 && ln -sf /opt/trtllm-venv/bin/trtllm-serve /opt/trtllm/bin/trtllm-serve \
 && ln -sf /opt/trtllm-venv/bin/trtllm-build /opt/trtllm/bin/trtllm-build \
 && ln -sf /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm /opt/trtllm/tensorrt_llm

WORKDIR /workspace

# Backend selector — switches $VIRTUAL_ENV/$PATH based on $DYNAMO_BACKEND.
COPY entrypoint.sh /usr/local/bin/dynamo-combined-entrypoint
RUN chmod +x /usr/local/bin/dynamo-combined-entrypoint

# EFA / NCCL / NIXL runtime environment. Unset HPCX so the base's OpenMPI
# takes precedence; the image defaults to DYNAMO_BACKEND=vllm so the
# frontend/worker entrypoints do not need to set it.
ENV LD_LIBRARY_PATH="/opt/nvidia/nvda_nixl/lib64:/opt/nvidia/nvda_nixl/lib64/plugins:/usr/local/ucx/lib:/opt/amazon/efa/lib:/opt/gdrcopy/lib:/opt/amazon/openmpi/lib:${LD_LIBRARY_PATH:-}" \
    PATH="/usr/local/ucx/bin:/opt/amazon/efa/bin:/opt/amazon/openmpi/bin:${PATH}" \
    OPAL_PREFIX=/opt/amazon/openmpi \
    FI_PROVIDER=efa \
    FI_EFA_USE_DEVICE_RDMA=1 \
    FI_EFA_ENABLE_SHM=0 \
    FI_EFA_ENABLE_SHM_TRANSFER=0 \
    NCCL_NET_PLUGIN=ofi \
    NCCL_TUNER_PLUGIN=ofi \
    NCCL_GIN_TYPE=2 \
    NCCL_NVLS_ENABLE=0 \
    NCCL_SOCKET_IFNAME="^lo,docker,veth,eni" \
    HPCX_DIR="" HPCX_MPI_DIR="" HPCX_HOME="" HPCX_UCX_DIR="" \
    DYNAMO_BACKEND=vllm

# Filesystem validation — runtime imports are deferred because the runtime
# image's ENTRYPOINT runs nvidia-smi which stalls `docker build` without a GPU.
RUN echo "=== dynamo-combined-efa build validation ===" \
 && ls /opt/nvidia/nvda_nixl/lib64/plugins/libplugin_LIBFABRIC.so \
 && echo "  NIXL LIBFABRIC plugin: present" \
 && ls /opt/amazon/efa/lib/libfabric.so* >/dev/null \
 && echo "  libfabric: present" \
 && ls /opt/trtllm-venv/bin/trtllm-serve >/dev/null \
 && ls /opt/trtllm-venv/lib/python3.12/site-packages/tensorrt_llm >/dev/null \
 && echo "  TRT-LLM venv present at /opt/trtllm-venv" \
 && (ls /opt/dynamo/venv/lib/python3.12/site-packages/vllm >/dev/null 2>&1 \
      && echo "  vLLM site-packages present at /opt/dynamo/venv" \
      || echo "  vLLM: deferred (runtime check)") \
 && echo "=== OK ==="

ENTRYPOINT ["/usr/local/bin/dynamo-combined-entrypoint"]
CMD ["--help"]
