# syntax=docker/dockerfile:1.10
# =============================================================================
# Dockerfile.efa — EFA Networking Base with Tests, SBOM & CVE Scanning
# =============================================================================
#
# Produces the EFA networking layer used by all downstream inference/training
# images. Includes the full EFA + NCCL + UCX + NIXL stack from networking-base:v5
# plus validation tests, SBOM generation (syft → SPDX + CycloneDX), and CVE
# scanning (trivy) baked into the build.
#
# Multi-arch build (linux/amd64 primary, linux/arm64 for CPU-only validation):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#       -f Dockerfile.efa -t efa-networking:v1 .
#
# Single-arch (typical for GPU nodes):
#   docker buildx build --platform linux/amd64 \
#       -f Dockerfile.efa -t efa-networking:v1 .
#
# Build args:
#   NETWORKING_BASE  — override the networking-base image (default: public ECR)
#   GENERATE_SBOM    — set to "0" to skip SBOM generation (default: "1")
#   CVE_SCAN         — set to "0" to skip CVE scan (default: "1")
#
# Outputs (inside the image at /opt/security/):
#   sbom.spdx.json       — SPDX 2.3 SBOM (machine-readable)
#   sbom.cyclonedx.json  — CycloneDX 1.5 SBOM (alternative format)
#   cve-report.txt       — Trivy vulnerability scan (CRITICAL + HIGH)
#   cve-critical.txt     — Trivy CRITICAL-only scan
#
# =============================================================================

ARG NETWORKING_BASE=public.ecr.aws/v9l4g5s4/networking-base:v5

# ---------------------
# Stage 1: networking source
# ---------------------
FROM ${NETWORKING_BASE} AS networking

# ---------------------
# Stage 2: security tooling (multi-arch compatible)
# ---------------------
FROM aquasec/trivy:latest AS trivy-bin
FROM anchore/syft:latest AS syft-bin

# ---------------------
# Stage 3: EFA networking layer with tests
# ---------------------
FROM ${NETWORKING_BASE} AS efa-base

USER root
WORKDIR /workspace

# Carry forward all networking env from base
ENV FI_PROVIDER=efa \
    FI_EFA_USE_DEVICE_RDMA=1 \
    FI_EFA_ENABLE_SHM=0 \
    FI_EFA_ENABLE_SHM_TRANSFER=0 \
    NCCL_NET_PLUGIN=ofi \
    NCCL_TUNER_PLUGIN=ofi \
    NCCL_GIN_TYPE=2 \
    NCCL_NVLS_ENABLE=0 \
    NCCL_SOCKET_IFNAME="^lo,docker,veth,eni"

# --- EFA / networking validation tests ---
COPY <<'TEST_SCRIPT' /opt/tests/run-efa-tests.sh
#!/usr/bin/env bash
set -euo pipefail
echo "=== EFA Networking Validation Tests ==="
PASS=0; FAIL=0

check() {
    local name="$1"; shift
    if "$@" >/dev/null 2>&1; then
        echo "  PASS: $name"; PASS=$((PASS+1))
    else
        echo "  FAIL: $name"; FAIL=$((FAIL+1))
    fi
}

echo ""
echo "--- Component presence ---"
check "libfabric"          test -f /opt/amazon/efa/lib/libfabric.so
check "fi_info"            which fi_info
check "GDRCopy"            test -f /opt/gdrcopy/lib/libgdrapi.so
check "UCX"                test -f /usr/local/ucx/lib/libucp.so
check "NIXL"               test -f /opt/nvidia/nvda_nixl/lib64/libnixl.so
check "NIXL libfabric plugin" test -f /opt/nvidia/nvda_nixl/lib64/plugins/libplugin_LIBFABRIC.so
check "NCCL"               test -f /usr/local/nccl/lib/libnccl.so
check "aws-ofi-nccl"       find /opt/amazon -name "libnccl-net-ofi.so" -print -quit | grep -q .
check "nccl-tests"         test -f /opt/nccl-tests/bin/all_reduce_perf
check "kubectl"            test -x /usr/local/bin/kubectl

echo ""
echo "--- Library versions ---"
fi_info --version 2>/dev/null | head -1 || echo "  fi_info: unavailable (no EFA hw)"
/usr/local/ucx/bin/ucx_info -v 2>/dev/null | head -1 || echo "  ucx_info: unavailable"
strings /usr/local/nccl/lib/libnccl.so 2>/dev/null | grep "NCCL version" | head -1 || echo "  NCCL version: unknown"

echo ""
echo "--- GIN plugin symbols ---"
OFI_SO=$(find /opt/amazon -name "libnccl-net-ofi.so" 2>/dev/null | head -1)
if [ -n "$OFI_SO" ] && nm -D "$OFI_SO" 2>/dev/null | grep -q ncclGin; then
    echo "  PASS: aws-ofi-nccl exports ncclGin symbols"; PASS=$((PASS+1))
else
    echo "  FAIL: aws-ofi-nccl missing ncclGin symbols"; FAIL=$((FAIL+1))
fi

echo ""
echo "--- Python packages ---"
for pkg in nixl nemo_evaluator nvidia_resiliency_ext; do
    if python3 -c "import $pkg" 2>/dev/null; then
        echo "  PASS: python3 import $pkg"; PASS=$((PASS+1))
    else
        echo "  FAIL: python3 import $pkg"; FAIL=$((FAIL+1))
    fi
done

echo ""
echo "=== Results: $PASS passed, $FAIL failed ==="
[ "$FAIL" -eq 0 ] || exit 1
TEST_SCRIPT

RUN chmod +x /opt/tests/run-efa-tests.sh

# Run validation tests at build time
RUN /opt/tests/run-efa-tests.sh

# ---------------------
# Stage 4: SBOM + CVE scanning
# ---------------------
FROM efa-base AS security-scan

ARG GENERATE_SBOM=1
ARG CVE_SCAN=1

# Copy scanner binaries from their official images
COPY --from=trivy-bin /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=syft-bin /syft /usr/local/bin/syft

RUN mkdir -p /opt/security

# Generate SBOM with syft (SPDX + CycloneDX)
RUN if [ "$GENERATE_SBOM" = "1" ]; then \
        echo "=== Generating SBOM (SPDX) ===" && \
        syft dir:/ -o spdx-json=/opt/security/sbom.spdx.json 2>/dev/null || \
            echo '{"comment":"sbom generation skipped or failed"}' > /opt/security/sbom.spdx.json && \
        echo "=== Generating SBOM (CycloneDX) ===" && \
        syft dir:/ -o cyclonedx-json=/opt/security/sbom.cyclonedx.json 2>/dev/null || \
            echo '{"comment":"sbom generation skipped or failed"}' > /opt/security/sbom.cyclonedx.json && \
        echo "SBOM generation complete"; \
    else \
        echo '{"comment":"sbom generation disabled"}' > /opt/security/sbom.spdx.json && \
        echo '{"comment":"sbom generation disabled"}' > /opt/security/sbom.cyclonedx.json; \
    fi

# CVE scan with trivy (filesystem mode — scans the image from within)
RUN if [ "$CVE_SCAN" = "1" ]; then \
        echo "=== CVE Scan (CRITICAL + HIGH) ===" && \
        trivy filesystem --scanners vuln --severity CRITICAL,HIGH \
            --skip-db-update --skip-java-db-update \
            --timeout 10m --quiet / > /opt/security/cve-report.txt 2>&1 || true && \
        echo "=== CVE Scan (CRITICAL only) ===" && \
        trivy filesystem --scanners vuln --severity CRITICAL \
            --skip-db-update --skip-java-db-update \
            --timeout 10m --quiet / > /opt/security/cve-critical.txt 2>&1 || true && \
        echo "CVE scan complete"; \
    else \
        echo "CVE scan disabled" > /opt/security/cve-report.txt && \
        echo "CVE scan disabled" > /opt/security/cve-critical.txt; \
    fi

# ---------------------
# Stage 5: final (clean — no scanner binaries, only results)
# ---------------------
FROM efa-base AS final

# Copy security artifacts (SBOM + CVE reports) but not the scanner binaries
COPY --from=security-scan /opt/security /opt/security
COPY --from=security-scan /opt/tests    /opt/tests

LABEL maintainer="nemo-rl" \
      description="EFA networking base with tests, SBOM, and CVE scan" \
      efa.version="1.48.0" \
      libfabric.version="2.4.0amzn3.0" \
      nccl.version="2.30.3" \
      ucx.version="1.20.0" \
      nixl.version="1.0.1" \
      security.sbom="spdx+cyclonedx at /opt/security/" \
      security.cve-scan="trivy at /opt/security/"
